doctype html
html(lang="en")
	head
		meta(charset="UTF-8")
		meta(http-equiv="Content-Type", content="text/html; charset=UTF-8")
		title Directory listing for #{directory}
		link(rel="icon" type="image/png" href="data:image/png;base64,iVBORw0KGgo=")
	body
		h1 Directory listing for #{directory}
		hr
		- const encodePath = path => path.split("/").map(encodeURIComponent).join("/")
		- const baseUrl = encodePath(directory).replace(/\/*$/, "/")
		ul
			if files.length
				each file in files
					li
						a(href=(baseUrl + encodePath(file)))= file
			else
				li No files in directory
		hr
